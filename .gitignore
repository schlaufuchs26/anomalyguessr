# No trailing slash: a worktree that symlinks node_modules (instead of a
# fresh install) puts a symlink here, which a "node_modules/" pattern would
# not ignore (dashboard #981 regression).
node_modules
dist/
coverage/
.env
*.log

# Playwright browser-smoke artifacts (ticket #1193)
test-results/
playwright-report/

# AnomalyGuessr runtime data (ticket #1261): the pipeline's queue
# (state.json, feedback.json), image caches (library/, sources/, audit/,
# ~370 MB). Written by the generator, the API and the ship step, never
# tracked: it is a local cache, and the repo is public. Backed up by
# fuchs' scripts/backup.sh instead.
data/

# Python bytecode from the pipeline suites (ticket #1261)
__pycache__/
*.pyc
