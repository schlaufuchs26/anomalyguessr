{
  "name": "anomalyguessr",
  "version": "0.2.0",
  "description": "Spot-the-anachronism game: find the one modern object an AI smuggled into a public-domain historical photo",
  "type": "module",
  "scripts": {
    "dev": "bun index.html",
    "build": "rm -rf dist && bun build index.html --outdir dist --target browser --minify --define 'process.env.NODE_ENV=\"production\"' && cp -r scenes dist/scenes && cp 404.html dist/404.html",
    "start": "bun index.html",
    "tsc": "tsc --pretty --noEmit",
    "format": "bun scripts/check-biome-config.ts && biome format --write .",
    "biome": "bun scripts/check-biome-config.ts && biome check --error-on-warnings .",
    "knip": "knip-bun",
    "checks": "bun run format && concurrently -g -c auto 'bun run tsc' 'bun run biome' 'bun run knip' 'bun run test'",
    "test": "bun test",
    "test:e2e": "playwright test",
    "test:coverage": "bun test --coverage",
    "test:ci": "bun test --coverage --coverage-reporter=lcov",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@happy-dom/global-registrator": "^20.10.2",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "bun-types": "latest",
    "concurrently": "^10.0.3",
    "knip": "^6.16.1",
    "typescript": "^5.7.0"
  }
}
